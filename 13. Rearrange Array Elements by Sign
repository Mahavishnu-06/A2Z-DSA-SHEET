Approach: Use two pointers (pos, neg) to place positive numbers at even indices and negative numbers at odd indices in a new array.

Time Complexity: O(n) — single traversal of the array.

Space Complexity: O(n) — extra array used to store rearranged elements.

class Solution {
    public int[] rearrangeArray(int[] nums) {
        int n=nums.length,pos=0,neg=1;
        int res[]=new int[n];
        for(int i=0;i<n;i++){
            if(nums[i]>0){
                res[pos]=nums[i];
                pos+=2;
            }else{
                res[neg]=nums[i];
                neg+=2;
            }
        }
        return res;
    }
}
