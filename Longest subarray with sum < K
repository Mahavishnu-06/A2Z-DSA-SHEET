import java.util.*;
public class Largestsumk {
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int arr[]=new int[n];
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }
        int k=sc.nextInt();
        int sum=0,maxlen=0;
        int left=0,right=0;
        while(right<n){
            sum+=arr[right];
            while(sum>k){
                sum-=arr[left];
                left++;
            }
            maxlen=Math.max(maxlen,right-left+1);
            
            right++;
        }
        System.out.println(maxlen);
    }
}

