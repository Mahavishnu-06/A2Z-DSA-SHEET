    public int subarray(int[] nums,int g){
        int left=0,right=0,n=nums.length,count=0,sum=0;
        while(right<n){
            if(g<0){
                return 0;
            }
             sum+=nums[right];
             while(sum>g){
                sum-=nums[left];
                left++;
             }
             count+=(right-left+1);
             right++;
        }
        return count;
    }
}
