Approach: Iterate through string and check every substring of length 3 by comparing characters directly to ensure all are distinct.

Time Complexity: O(n) — single pass checking fixed-size substrings.

Space Complexity: O(1) — no extra data structures used.

class Solution {
    public int countGoodSubstrings(String s) {
        int count=0;
          for (int i = 0; i <= s.length() - 3; i++) {
            char a = s.charAt(i);
            char b = s.charAt(i + 1);
            char c = s.charAt(i + 2);
            if (a != b && a != c && b != c) {
                count++;
            }
        }
