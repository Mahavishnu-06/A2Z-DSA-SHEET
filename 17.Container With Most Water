class Solution {
    public int maxArea(int[] h) {
        int n=h.length;
        int left=0,right=n-1,max=Integer.MIN_VALUE;
        while(left<right){
            int width=right-left;
            int height=Math.min(h[left],h[right]);
            max=Math.max(max,width*height);
            if(h[left]<h[right]){
                left++;
            }else{
                right--;
            }
        }
        return max;  
