        //    sb.append(arr[i]);
        // sb.append(" ");
        // }
        // return sb.toString().trim();
    }
    public String[] reverse(String str[],int i,int j){
        if(i>=j){
           return str;
        }
        String temp=str[i];
        str[i]=str[j];
        str[j]=temp;
        return reverse(str,i+1,j-1);
    }    
}
